{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BrowseBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::storage-service-browse-*",
        "arn:aws:s3:::storage-service-browse-*/*"
      ]
    }
  ]
}
